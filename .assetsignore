# Files in this directory that must NOT be uploaded as public static assets.
# Wrangler (Workers Static Assets) reads this like a .gitignore.

.git
.git/**
.wrangler
.wrangler/**
.gitignore
.assetsignore
.DS_Store
**/.DS_Store
node_modules
node_modules/**

# Repo docs / deploy config — no reason to serve these
AGENTS.md
CLAUDE.md
wrangler.jsonc

# React/Three.js source for the Avora Core hero island — only its built
# output (app-dist/, produced by `npm run build`) needs to be public.
components
components/**
src
src/**
package.json
package-lock.json
tsconfig.json
vite.config.ts
.mcp.json

# Worker source (/api/contact) — only reachable as a route, never served
# as a static file. Secrets live in Worker secrets, never in this source.
worker
worker/**
