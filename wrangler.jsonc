{
  "name": "agency-website",
  "compatibility_date": "2026-08-25",
  "main": "worker/contact.ts",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"]
  },
  "durable_objects": {
